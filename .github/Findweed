<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MR.WEEDELIVER</title>
  <style>
    :root {
      --bg-dark: #0a0f0d;
      --card-bg: #121a15;
      --neon-green: #39ff14;
      --emerald-green: #00ff66;
      --text-light: #e0e6e3;
      --text-muted: #8a9a90;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-light);
      line-height: 1.6;
    }

    /* Green Shining Animation & Glow Utility */
    .glow-text {
      color: var(--neon-green);
      text-shadow: 0 0 10px var(--neon-green), 
                   0 0 20px var(--neon-green), 
                   0 0 40px var(--emerald-green);
      animation: pulse-glow 2s infinite alternate;
    }

    .glow-box {
      border: 1px solid var(--neon-green);
      box-shadow: 0 0 15px rgba(57, 255, 20, 0.2);
      transition: all 0.3s ease;
    }

    .glow-box:hover {
      box-shadow: 0 0 25px rgba(57, 255, 20, 0.6);
    }

    @keyframes pulse-glow {
      0% { text-shadow: 0 0 8px var(--neon-green), 0 0 15px var(--neon-green); }
      100% { text-shadow: 0 0 15px var(--neon-green), 0 0 30px var(--emerald-green); }
    }

    /* Header & Navigation */
    header {
      background-color: rgba(10, 15, 13, 0.95);
      position: fixed;
      width: 100%;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid rgba(57, 255, 20, 0.3);
      backdrop-filter: blur(5px);
    }

    nav {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: bold;
      letter-spacing: 1.5px;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 1.5rem;
    }

    .nav-links a {
      color: var(--text-light);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s;
    }

    .nav-links a:hover {
      color: var(--neon-green);
    }

    /* Hero Section */
    .hero {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 1rem;
      background: radial-gradient(circle at center, #14281d 0%, var(--bg-dark) 70%);
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .hero p {
      font-size: 1.25rem;
      color: var(--text-muted);
      max-width: 600px;
      margin-bottom: 2rem;
    }

    /* Buttons */
    .btn {
      display: inline-block;
      padding: 0.8rem 2rem;
      background: transparent;
      color: var(--neon-green);
      border: 2px solid var(--neon-green);
      border-radius: 30px;
      font-size: 1rem;
      font-weight: bold;
      text-decoration: none;
      box-shadow: 0 0 10px rgba(57, 255, 20, 0.4);
      transition: all 0.3s ease;
    }

    .btn:hover {
      background: var(--neon-green);
      color: var(--bg-dark);
      box-shadow: 0 0 20px var(--neon-green);
      transform: translateY(-2px);
    }

    /* Section Structure */
    .section {
      padding: 5rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      text-align: center;
      font-size: 2.2rem;
      margin-bottom: 3rem;
    }

    /* Main Section: Findweed to MR.WEEDELIVER */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }

    .card {
      background: var(--card-bg);
      padding: 2rem;
      border-radius: 12px;
      text-align: center;
    }

    .card h3 {
      margin-bottom: 1rem;
      color: var(--neon-green);
    }

    /* Contact Cards */
    .contact-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
      margin-top: 2rem;
    }

    .contact-card {
      background: var(--card-bg);
      padding: 2rem;
      border-radius: 12px;
      min-width: 280px;
      text-align: center;
    }

    .contact-card a {
      color: var(--neon-green);
      text-decoration: none;
      word-break: break-all;
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 2rem;
      border-top: 1px solid rgba(57, 255, 20, 0.2);
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2.2rem; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

