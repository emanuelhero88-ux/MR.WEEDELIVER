        <a href="https://wa.me/27675882113" target="_blank" class="btn">+27 67 588 2113</a>
      </div>

      <!-- Email Box -->
      <div class="contact-card glow-box">
        <h3>Email Us</h3>
        <p style="margin-bottom: 1rem;">Send us an email for general inquiries:</p>
        <a href="mailto:hunterdelivery66@gmail.com" class="btn">hunterdelivery66@gmail.com</a>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 <span class="glow-text">MR.WEEDELIVER</span>. All rights reserved.</p>
  </footer>

</body>
</html>
